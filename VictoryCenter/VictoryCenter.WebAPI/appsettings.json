{
  "ConnectionStrings": {
    "DefaultConnection": "${DB_CONNECTION_STRING}"
  },
  "BlobEnvironmentVariables": {
    "ServiceType": "Local",
    "Local": {
      "ImagesSubPath": "Images",
      "PdfSubPath": "PdfReports"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Audience": "VictoryCenter.Client",
    "Issuer": "VictoryCenter.Api",
    "LifetimeInMinutes": 1440,
    "SecretKey": "${JWTOPTIONS_SECRETKEY}",
    "RefreshTokenSecretKey": "${JWTOPTIONS_REFRESH_TOKEN_SECRETKEY}",
    "RefreshTokenLifetimeInDays": 7
  },
  "CORS": {
    "AllowedOrigins": [
      "https://victorycenter.online"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ],
    "ExposedHeaders": [
      "*"
    ],
    "PreflightMaxAge": "600"
  },
  "CloudflareTurnstileCaptchaOptions": {
    "SecretKey": "${CLOUDFLARE_TURNSTILE_SECRET_KEY}",
    "SiteVerifyUrl": "${CLOUDFLARE_TURNSTILE_SITE_VERIFY_URL}"
  },
  "EmailOptions": {
    "EmailProvider": "Dummy"
  },
  "ContactUsEmailOptions": {
    "FromAddress": "${CONTACT_US_EMAIL_OPTIONS_FROM_ADDRESS}"
  }
}