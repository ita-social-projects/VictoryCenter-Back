{
  "ConnectionStrings": {
    "DefaultConnection": "${INTEGRATION_TESTS_DB_CONNECTION_STRING}"
  },
  "BlobEnvironmentVariables": {
    "ServiceType": "Local",
    "Local": {
      "ImagesSubPath": "ImagesIntegrationTest",
      "PdfSubPath": "PdfReportsIntegrationTest"
    }
  },
  "JwtOptions": {
    "Audience": "VictoryCenter.Client",
    "Issuer": "VictoryCenter.Api",
    "LifetimeInMinutes": 15,
    "SecretKey": "${JWTOPTIONS_SECRETKEY}",
    "RefreshTokenSecretKey": "${JWTOPTIONS_REFRESH_TOKEN_SECRETKEY}",
    "RefreshTokenLifetimeInDays": 7
  },
  "AccountLockout": {
    "MaxFailedAccessAttempts": 5,
    "LockoutMinutes": 15
  },
  "ContentLock": {
    "EnforcementEnabled": true,
    "TtlMinutes": 3,
    "RenewalIntervalSeconds": 30,
    "ExpirationScanIntervalSeconds": 15
  },
  "CORS": {
    "AllowedOrigins": [
      "*"
    ],
    "AllowedHeaders": [
      "*"
    ],
    "AllowedMethods": [
      "*"
    ],
    "PreflightMaxAge": 1,
    "ExposedHeaders": [
      "*",
      "X-Content-Lock-Enforced"
    ]
  },
  "PaymentSystemsConfigurations": {
    "Way4Pay": {
      "MerchantLogin": "MOCK_VALUE",
      "MerchantSecretKey": "MOCK_VALUE",
      "MerchantDomainName": "MOCK_VALUE",
      "ApiUrl": "https://mock/pay",
      "AllowedReturnUrlHosts": [
        "donate.example.com"
      ]
    }
  },
  "EmailOptions": {
    "EmailProvider": "Dummy"
  }
}

